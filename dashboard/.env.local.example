# Public — safe to expose to the browser (Supabase anon key)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public — shown in the Quick Start code block on the dashboard
NEXT_PUBLIC_GATEWAY_URL=https://your-gateway.com

# Server-only — never sent to the browser
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Stripe — create keys at dashboard.stripe.com
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...  (from `stripe listen` or the dashboard)

# App origin — used to build Stripe redirect URLs in server-side API routes
NEXT_PUBLIC_APP_URL=https://your-dashboard.com
